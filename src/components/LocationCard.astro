---
interface Props {
  name: string;
  address: string;
  city: string;
  state: string;
  zip: string;
  note?: string;
  phone: string;
  hours: Array<{ days: string; time: string; closed?: boolean }>;
}

const { name, address, city, state, zip, note, phone, hours } = Astro.props;
---

<div class="location-card">
  <h3 class="location-name">{name}</h3>

  <div class="location-info">
    <!-- Address -->
    <div class="info-row">
      <svg
        class="info-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      <div class="info-content">
        <p class="address-line">{address}</p>
        <p class="address-line">{city}, {state} {zip}</p>
        {note && <p class="address-note">{note}</p>}
      </div>
    </div>

    <!-- Phone -->
    <div class="info-row">
      <svg
        class="info-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
        ></path>
      </svg>
      <a href={`tel:${phone.replace(/-/g, "")}`} class="phone-link">{phone}</a>
    </div>

    <!-- Hours -->
    <div class="info-row hours-row">
      <svg
        class="info-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <div class="hours-list">
        {
          hours.map((h) => (
            <p class={`hours-item ${h.closed ? "closed" : ""}`}>
              <span class="hours-days">{h.days}:</span>
              <span class="hours-time">{h.time}</span>
            </p>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .location-card {
    background-color: #1f2937;
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid #374151;
    transition: border-color 0.3s ease;
  }

  .location-card:hover {
    border-color: var(--color-pizza-red);
  }

  .location-name {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-pizza-gold);
    margin-bottom: 1rem;
  }

  .location-info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .info-row {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .info-icon {
    color: var(--color-pizza-red);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .info-content {
    color: #d1d5db;
    font-size: 0.875rem;
  }

  .address-line {
    color: white;
    font-weight: 700;
  }

  .address-line + .address-line {
    color: #d1d5db;
    font-weight: 400;
  }

  .address-note {
    font-size: 0.75rem;
    font-style: italic;
    color: #9ca3af;
    margin-top: 0.25rem;
  }

  .phone-link {
    color: white;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .phone-link:hover {
    color: var(--color-pizza-red);
  }

  .hours-list {
    font-size: 0.875rem;
    color: #d1d5db;
  }

  .hours-item {
    display: flex;
    gap: 0.5rem;
  }

  .hours-days {
    color: #9ca3af;
    min-width: 5rem;
  }

  .hours-item.closed .hours-days {
    color: #ef4444;
  }

  .hours-item.closed .hours-time {
    color: #ef4444;
  }
</style>
